# Groq Cloud API Key (get from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq LLM model name (supported models: qwen/qwen3.8-27b, openai/gpt-oss-20b)
GROQ_MODEL=qwen/qwen3.8-27b

# Chroma DB persistence path (relative to evyatra-ai or absolute)
CHROMA_DB_DIR=./db

# Server port
PORT=8001
